# Copy this file to .env and fill in your real keys
# None of these values are committed to git (.env is in .gitignore)

# RapidAPI (shazam.p.rapidapi.com) - songs/detect, search, get-details
RAPIDAPI_KEY=

# shazam-api.com - independent recognize quota (audio fingerprinting)
SHAZAM_API_COM_KEY=

# Django settings
DJANGO_SECRET_KEY=

# Optional overrides
# RADIO_DISABLE=IFM           # comma-separated station names to skip
# RADIO_NAME=Mosaique FM       # single-station mode (with RADIO_URL)
# RADIO_URL=https://radio.mosaiquefm.net/mosalive
# MUSIC_THRESHOLD=0.8
# ENGINE_MIN_CONFIDENCE=0.15
