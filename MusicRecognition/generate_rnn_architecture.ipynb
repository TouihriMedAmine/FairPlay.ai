import argparse
from pathlib import Path

import matplotlib.pyplot as plt
from matplotlib.patches import FancyBboxPatch
import tensorflow as tf


def _shape_to_str(shape) -> str:
    if shape is None:
        return "unknown"
    if hasattr(shape, "as_list"):
        shape = shape.as_list()
    return "(" + ", ".join("None" if x is None else str(x) for x in shape) + ")"


def _layer_output_shape(layer) -> str:
    output = getattr(layer, "output", None)
    if output is None:
        return "unknown"
    if isinstance(output, (list, tuple)):
        return ", ".join(_shape_to_str(t.shape) for t in output)
    return _shape_to_str(output.shape)


def _draw_architecture_fallback(model: tf.keras.Model, output_path: Path) -> None:
    layer_texts = []
    for layer in model.layers:
        layer_texts.append(
            "\n".join(
                [
                    layer.name,
                    f"Type: {layer.__class__.__name__}",
                    f"Output: {_layer_output_shape(layer)}",
                    f"Params: {layer.count_params()}",
                ]
            )
        )

    box_height = 1.35
    box_gap = 0.55
    top_margin = 0.8
    bottom_margin = 0.8
    fig_height = max(6, top_margin + bottom_margin + len(layer_texts) * (box_height + box_gap))

    fig, ax = plt.subplots(figsize=(12, fig_height))
    ax.set_xlim(0, 10)
    ax.set_ylim(0, fig_height)
    ax.axis("off")

    title = f"Model: {model.name}\nTotal params: {model.count_params():,}"
    ax.text(5, fig_height - 0.25, title, ha="center", va="top", fontsize=16, fontweight="bold")

    y = fig_height - top_margin - box_height
    for index, text in enumerate(layer_texts):
        box = FancyBboxPatch(
            (1.1, y),
            7.8,
            box_height,
            boxstyle="round,pad=0.03,rounding_size=0.08",
            linewidth=1.6,
            edgecolor="#1f4e79",
            facecolor="#dbeafe",
        )
        ax.add_patch(box)
        ax.text(5, y + box_height / 2, text, ha="center", va="center", fontsize=11)

        if index < len(layer_texts) - 1:
            ax.annotate(
                "",
                xy=(5, y - box_gap + 0.08),
                xytext=(5, y),
                arrowprops=dict(arrowstyle="->", lw=1.8, color="#374151"),
            )
        y -= box_height + box_gap

    fig.tight_layout()
    fig.savefig(output_path, dpi=220, bbox_inches="tight")
    plt.close(fig)


def export_model_architecture(model_path: Path, output_path: Path) -> None:
    model = tf.keras.models.load_model(model_path)

    output_path.parent.mkdir(parents=True, exist_ok=True)

    try:
        tf.keras.utils.plot_model(
            model,
            to_file=str(output_path),
            show_shapes=True,
            show_dtype=False,
            show_layer_names=True,
            rankdir="TB",
            expand_nested=True,
            dpi=220,
        )
    except Exception:
        _draw_architecture_fallback(model, output_path)

    if not output_path.exists():
        _draw_architecture_fallback(model, output_path)

    print(f"Loaded model: {model_path}")
    print(f"Architecture image saved to: {output_path}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Load an RNN Keras model and export its architecture as an image."
    )
    parser.add_argument(
        "--model",
        required=True,
        help="Path to the saved RNN model (.h5 or .keras).",
    )
    parser.add_argument(
        "--output",
        default="rnn_architecture.png",
        help="Output image path.",
    )
    args = parser.parse_args()

    model_path = Path(args.model).expanduser().resolve()
    output_path = Path(args.output).expanduser().resolve()

    if not model_path.exists():
        raise FileNotFoundError(f"Model file not found: {model_path}")

    export_model_architecture(model_path, output_path)


if __name__ == "__main__":
    main()
